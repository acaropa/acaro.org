# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Base de datos (MySQL) ──────────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=                    # REQUERIDO — mínimo 32 caracteres aleatorios
ACCESS_TOKEN_EXPIRES_IN=15m    # duración del access token (en memoria del cliente)
SESSION_HOURS=8                # duración de la sesión (refresh token en base de datos)
SESSION_RETENTION_DAYS=30      # días antes de purgar sesiones expiradas/revocadas

# ── CORS y URLs ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://acaro.org

# ── Subida de archivos ────────────────────────────────────────────────────────
# Ruta absoluta donde se guardan los uploads. Si está vacío, se calcula automáticamente
# según la estructura de Hostinger (../uploads relativo al directorio nodejs).
UPLOAD_ROOT=

# ── Rate limiting (solicitudes por ventana de tiempo) ────────────────────────
# Dejar vacío para usar los valores por defecto indicados entre paréntesis.
RATE_LIMIT_DEFAULT=600          # (600 req / 15 min) — tráfico general
RATE_LIMIT_LOGIN=10             # (10 intentos fallidos / 15 min) por IP
RATE_LIMIT_REGISTER=5           # (5 registros / hora) por IP
RATE_LIMIT_PASSWORD_RECOVERY=5  # (5 solicitudes / hora) por IP
RATE_LIMIT_CONTACT=10           # (10 mensajes / hora) por IP
RATE_LIMIT_UPLOAD=30            # (30 subidas / hora) por IP
RATE_LIMIT_SURVEY_RESPONSE=20   # (20 respuestas / hora) por IP
RATE_LIMIT_SURVEY_CREATE=20     # (20 encuestas / hora) por IP
RATE_LIMIT_ADMIN=200            # (200 req / 15 min) rutas admin sensibles
